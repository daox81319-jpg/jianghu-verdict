"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50), Object(InputEventJoypadButton,"button_index":2)]
}
quick_evidence_3={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":51), Object(InputEventJoypadButton,"button_index":3)]
}
restart_case={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82), Object(InputEventJoypadButton,"button_index":12)]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[audio]

